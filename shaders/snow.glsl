// ============================================================================
//  snow.glsl — общий блок снегового покрова (включается во ВСЕ шейдеры
//  поверхностей: terrain.fs, mesh.fs, object.fs, wheat.fs).
// ----------------------------------------------------------------------------
//  Единая «гибкая» схема: uSnowCover 0..1 растёт под снегопадом (fx.c),
//  uSnowMask — запечённая карта «видимость неба» (unit 8, RG8: R = открыт
//  верх). Шум из img/noise.png (uNoise) задаёт пятна накопления: снег
//  падает НЕРАВНОМЕРНО, но по мере роста uSnowCover порог снижается и
//  покров постепенно (медленно, минуты) заполняет ВСЮ открытую землю.
//
//  Каждый шейдер перед вызовом задаёт: wp = мировая точка, up = мера
//  «верха» 0..1 (N.y у объёмных, vUV-«верх» у биллбордов). Остальное —
//  общее.
// ============================================================================

// Возвращает вес снегового покрова 0..1 для точки wp (up — «верх» 0..1).
float snow_amount(vec3 wp, float up) {
    if (uSnowCover <= 0.001) return 0.0;
    // Открытие небу: R-канал маски (запечённые нависающие кроны).
    float smask = texture(uSnowMask, wp.xz / uWorldSize).r;
    // Три частоты шума img/noise.png: крупные сугробы (~40 м), средние
    // пятна (~8 м), мелкая кромка (~1.6 м). Падение неравномерное.
    float sn1 = texture(uNoise, wp.xz / 40.0).r;
    float sn2 = texture(uNoise, wp.xz / 8.0 + 12.34).r;
    float sn3 = texture(uNoise, wp.xz / 1.6 - 5.7).r;
    // Порог накопления падает с ростом uSnowCover: сначала снег лежит
    // только в «сугробных» ямах (sn1>0.6), затем (uSnowCover->1) порог
    // уходит ниже нуля — покрывается ВСЯ открытая площадь.
    float thr = 0.85 - uSnowCover * 1.55;      // 0.85 .. -0.70
    float acc = smoothstep(thr, thr + 0.45, sn1 * 0.72 + sn2 * 0.28);
    // Края пятна дрожат от мелкого шума и «сползут» при таянии.
    acc *= smoothstep(thr + 0.05, thr + 0.5, sn3);
    // Снег лежит только наверх-ориентированных гранях и там, где небо
    // открыто.
    return acc * up * smask;
}

// Цвет снега: слегка холодный, с шумным микрорельефом (сугробы светлее).
vec3 snow_color(vec3 base, vec3 wp, float a) {
    float sn1 = texture(uNoise, wp.xz / 40.0).r;
    float sn3 = texture(uNoise, wp.xz / 1.6 - 5.7).r;
    vec3 col = vec3(0.92, 0.94, 1.00) * (0.86 + 0.10 * sn1 + 0.05 * sn3);
    // Не полностью глушим подложку: тонкая плёнка снега сохраняет оттенок
    // (трава зеленеет из-под первой пороши).
    return mix(base, mix(base * 0.85, col, 0.94), a);
}
