// ============================================================================
//  PlayerBox — вершинный шейдер спрайта персонажа и рёбер коллизии
// ----------------------------------------------------------------------------
//  Позиции вершин уже в мире (строит узел PlayerBox): спрайт-квад стоит
//  ногами на земле персонажа, рёбра бокса — 12 отрезков вокруг него.
// ============================================================================

layout (location = 0) in vec3 aPos;   // мировая позиция вершины
layout (location = 1) in vec2 aUV;    // uv для спрайта (для линий — любые)

uniform mat4 uViewProj;               // вид * проекция (видовая камера)

out vec2 vUV;

void main() {
    vUV = aUV;
    gl_Position = uViewProj * vec4(aPos, 1.0);
}
