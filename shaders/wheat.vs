// ============================================================================
//  Vegetation — вершинный шейдер растительности (инстансинг)
// ----------------------------------------------------------------------------
//  Базовая сетка — одиночный квад (4 вершины, 6 индексов). Атрибуты
//  экземпляра (12 float): iPos (x,y,z), iN (nx,nz — нормаль земли),
//  iAttr (yaw, scale, tint, layer), iLean (наклон вбок),
//  iSlope (dh/dx, dh/dz — уклон земли).
//  Растение стоит ВДОЛЬ НОРМАЛИ земли: на склонах оно наклоняется вместе
//  с рельефом. База ложится на рельеф по уклону (без выборки текстуры
//  высот — высота и уклоны уже посчитаны в C), верхушка покачивается
//  на ветру (uTime). Вся растительность — 4 инстансных вызова
//  (статик/динамик слои x трава/пшеница), один шейдер.
// ============================================================================

layout (location = 0) in vec3 aPos;    // локальная точка (x, 0..1, z)
layout (location = 1) in vec2 aUV;     // uv спрайта
layout (location = 2) in vec3 iPos;    // экземпляр: позиция растения
layout (location = 3) in vec2 iN;      // экземпляр: нормаль земли (nx, nz)
layout (location = 4) in vec4 iAttr;   // экземпляр: yaw, масштаб, тон, вид
layout (location = 5) in float iLean;  // экземпляр: наклон вбок
layout (location = 6) in vec2 iSlope;  // экземпляр: уклон земли (dh/dx, dh/dz)

uniform mat4 uViewProj;                // вид * проекция (из узла Camera)
uniform float uTime;                   // время симуляции (ветер)
uniform vec3 uCamPos;                  // игрок (для прогиба растительности)
uniform float uWalk;                   // 1 = ходьба (сильнее раздвигаем)
uniform float uDyn;                    // 1 = динамический слой (вокруг камеры)
uniform float uWindBoost;              // мокрость 0..1: в дождь ветер сильнее

// Виды (iAttr.w): 0/1/2 — три вида травы, 3 — одуванчик, 4 — пшеница.
// Индекс вида = базовый слой 2D-массива спрайтов. Пшеница получает LOD
// (слои 4/5/6) как прежде — трава/одуванчик самплируются как есть.
#define WHEAT_BASE  4.0
#define WHEAT_MARK  3.5

// Прогиб под игроком и раскрой спрайта — общий блок с shadowveg.vs
// (числа обязаны совпадать, иначе тень уезжает от растения).
#include "veg_common.glsl"

out vec2 vUV;
out vec2 vUVBase;   // UV спрайта [0,1] без выреза холста (для FS-смешивания LOD)
out vec3 vWorldPos;
out vec3 vNormal;      // нормаль квада (для света)
out float vTint;
flat out float vLayer;   // LOD целый для всего квада (не интерполировать)
out float vHeight;     // высота растения в метрах (для затемнения низа)

void main() {
    float ny = sqrt(max(1.0 - dot(iN, iN), 0.0));
    vec3 up = vec3(iN.x, ny, iN.y);            // нормаль земли (вверх)
    float ca = cos(iAttr.x), sa = sin(iAttr.x);
    vec3 hvec = vec3(ca, 0.0, sa);             // ширина квада (по yaw)

    // LOD пшеницы по дистанции до игрока, БЕЗ резких скачков. Трава и
    // одуванчик (слои 0..3) не меняются.
    float layer = iAttr.w;
    float wx = 128.0;                     // ширина спрайта на холсте (px)
    if (layer > WHEAT_MARK) {
        float dist = length(iPos.xz - uCamPos.xz);
        // Слой и ширина спрайта переходят КОРОТКОЙ полосой (0.8 м):
        // crossfade виден, но полоса полупрозрачных "призраков" узкая —
        // края растений остаются чёткими.
        float ss1 = smoothstep(4.6, 5.4, dist);
        float ss2 = smoothstep(24.5, 25.5, dist);
        // lod2 (растянутый) рисует только СТАТИЧЕСКИЙ слой — он покрывает
        // всю карту. Динамика после lod1 лишняя: иначе lod2 виден дважды
        // (плотное кольцо на краю динамики + растянутый по всей карте).
        // Динамика остаётся lod1 и исчезает на полосе 24.5-25 м.
        if (uDyn > 0.5 && ss2 > 0.5) {
            gl_Position = vec4(2.0, 2.0, 2.0, 1.0);
            return;
        }
        layer = WHEAT_BASE + ss1 + ss2;   // непрерывный слой 4..5..6
        wx = mix(128.0, 152.0, ss1);
        // lod2: СРАЗУ максимальная ширина (x10 = 1280) на всей дистанции
        // — текстура растянута везде одинаково, дыр не видно. Динамике
        // растяжка не нужна — она не доживает до lod2.
        if (uDyn < 0.5) wx = mix(wx, 1280.0, ss2);
        // ПРОРЕЖИВАНИЕ — ПО КАЖДОМУ РАСТЕНИЮ: хэш позиции точки против
        // keep. Точки гибнут независимо и случайно — "по шуму", без
        // ячеек, решёток и дырок. lod1: 1 из 4; lod2: 3 из 16 —
        // ОДИНАКОВАЯ плотность на всей дистанции lod2.
        float k1 = smoothstep(4.0, 8.0, dist);
        float k2 = smoothstep(22.0, 30.0, dist);
        float keep = 1.0;
        keep = mix(keep, 0.25, k1);       // lod1: 1 из 4
        keep = mix(keep, 0.25, k2);       // lod2: 1 из 4, везде одинакова
        float h = fract(sin(dot(iPos.xz + vec2(0.123, 0.456),
                                vec2(12.9898, 78.233))) * 43758.5453);
        if (h >= keep) {
            gl_Position = vec4(2.0, 2.0, 2.0, 1.0);   // за пределами — отсечён
            return;
        }
    }
    // КВАД РАСТЁТ ВМЕСТЕ С ТЕКСТУРОЙ LOD: lod1 шире lod0 (152/128),
    // lod2 растягивается плавно от 152 до x10 (1280) к краю видимости —
    // вдали спрайт размывается в сплошное поле, дыр нет. Множитель —
    // wx, посчитанный выше.
    float wmul = wx / 128.0;

    // горизонтальное смещение вершины от центра растения
    float hw = aPos.x * iAttr.y * wmul;
    vec3 wp = iPos + hvec * hw;

    // БАЗА РАСТЕНИЯ ЛЕЖИТ РОВНО НА РЕЛЬЕФЕ: высота под углами квада
    // считается из уклона земли (iSlope, посчитан от тех же квантованных
    // высот, что и рельеф) — углы не "всплывают" и не зарываются на
    // склонах, а вершинный шейдер обходится без текстурных выборок.
    // iPos.y — ровно высота земли (утапливание и подскок убраны в
    // vegetation.c), поэтому низ спрайта садится точно на меш рельефа.
    wp.y = iPos.y + (iSlope.x * hvec.x + iSlope.y * hvec.z) * hw;

    // вверх вдоль нормали земли + наклон верхушки к ширине (как в жизни).
    // Пшеница (вид 4) вытянута в высоту в 3 раза — узкий высокий колос.
    float ht = iAttr.y * (iAttr.w > WHEAT_MARK ? 3.0 : 1.0);
    // КВАД УКОРОЧЕН ДО НЕПРОЗРАЧНОЙ ЧАСТИ КАРТИНКИ (см. veg_common.glsl):
    // верх спрайтов пустой, и раньше эта треть площади растеризовалась только
    // чтобы уйти в discard. vis — ВИДИМАЯ высота растения; на экране пиксели
    // те же, фрагментов меньше (~30% у травы, ~10% у пшеницы).
    float cf = veg_content_frac(layer);
    float vis = ht * cf;
    float lc = cos(iLean), ls = sin(iLean);
    vec3 lt = hvec * (aPos.y * ls * iAttr.y * wmul)
            + up  * (aPos.y * lc * vis);
    wp += lt;

    // ВЕТЕР, не однообразный: два синуса с разнесёнными частотами
    // (1.15 и 2.35 рад/с), фазы — от места в мире И поворота растения,
    // амплитуда — своя у каждого пучка (0.7..1.3x). Второй синус гнёт
    // в другом направлении — волны живые, не синхронные.
    float ph = dot(iPos.xz, vec2(0.71, 0.39)) + iAttr.x * 2.5;
    float w1 = sin(uTime * 1.15 + ph);
    float w2 = sin(uTime * 2.35 + dot(iPos.xz * 1.7, vec2(0.53, -0.81))
                   + iAttr.w * 4.0);
    float amp = (0.7 + 0.6 * fract(iPos.x * 0.37 + iPos.z * 0.91))
              * (1.0 + 0.6 * uWindBoost);   // дождь = ветер +60% амплитуда
    float sway = (w1 * 0.07 + w2 * 0.035) * aPos.y * amp;
    wp.x += sway;
    wp.z += sway * 0.35 + w2 * 0.02 * aPos.y;

    // ПРОГИБ ПОД ПЕРСОНАЖЕМ (общий блок veg_common.glsl): растение
    // ПОВОРАЧИВАЕТСЯ вокруг основания в сторону от игрока, а не сдвигается
    // на метры — «дикого растопыривания» больше нет, длина стебля
    // сохраняется. Сила растёт с высотой растения: низкая щётка почти не
    // реагирует, высокая пшеница кланяется полностью.
    vec2 bdir;
    float bang = veg_bend_angle(iPos.xz, iPos.y, uCamPos, vis, aPos.y, uWalk,
                                bdir);
    if (bang > 0.0) {
        float rise = aPos.y * lc * vis;     // высота этой вершины над базой
        wp.xz += bdir * (sin(bang) * rise);
        wp.y  -= (1.0 - cos(bang)) * rise;
    }

    // UV: квад укорочен до непрозрачной части, значит и UV сжимается — иначе
    // картинка растянулась бы. aUV.y: 1 у основания, 0 у верха.
    vec2 auv = vec2(aUV.x, 1.0 - (1.0 - aUV.y) * cf);
    vUVBase = auv;   // UV [0,1] без выреза — FS сам возьмёт нужный кусок холста
    vUV = auv;
    // Холст 2D-массива 256x178, спрайты лежат слева сверху: три вида травы
    // и одуванчик 128x128 (кусок 128x128), пшеница lod0 128x178, lod1 152x178,
    // lod2 256x178. Для пшеницы кусок берём по текущей ширине wx
    // (непрерывная между LOD); точные куски каждого слоя считает wheat.fs.
    if (layer < WHEAT_MARK)  vUV *= vec2(128.0 / 256.0, 128.0 / 178.0);
    else                     vUV *= vec2(wx / 256.0, 1.0);
    vWorldPos = wp;
    vNormal = normalize(cross(hvec, up));      // лицевая нормаль квада
    vTint = iAttr.z;
    vLayer = layer;
    vHeight = vis;                             // верх растения = vis метров
    gl_Position = uViewProj * vec4(wp, 1.0);
}
