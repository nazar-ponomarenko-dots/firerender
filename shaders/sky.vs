// ============================================================================
//  Sky — вершинный шейдер скайбокса
// ----------------------------------------------------------------------------
//  Полноэкранный треугольник: весь небосвод рисует фрагментный шейдер,
//  восстанавливая направление луча из базиса камеры. Никаких сфер и швов.
// ============================================================================

layout (location = 0) in vec2 aPos;   // NDC: (-1,-1), (3,-1), (-1,3)

out vec2 vPos;

void main() {
    vPos = aPos;
    gl_Position = vec4(aPos, 1.0, 1.0);
}
