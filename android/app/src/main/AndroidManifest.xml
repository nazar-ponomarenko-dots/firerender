<?xml version="1.0" encoding="utf-8"?>
<!-- firerender: SDLActivity поднимает нативный main() из libmain.so -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ru.zaworg.firerender"
    android:versionCode="662"
    android:versionName="0.1.662">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="firerender"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:hasCode="true"
        android:extractNativeLibs="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode|smallestScreenSize"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
